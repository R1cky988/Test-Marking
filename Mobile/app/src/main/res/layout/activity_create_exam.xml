<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtExamName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập tên bài thi"
        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:id="@+id/edtTotalQuestions"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập số câu hỏi (ví dụ: 20)"
        android:inputType="number"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/edtExamName" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAnswerKey"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveExam"
        app:layout_constraintTop_toBottomOf="@id/edtTotalQuestions" />

    <Button
        android:id="@+id/btnSaveExam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Lưu bài thi"
        app:backgroundTint="#32A6D0"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnReturn"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    <Button
        android:id="@+id/btnReturn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Quay lại"
        app:backgroundTint="#32A6D0"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSaveExam"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>