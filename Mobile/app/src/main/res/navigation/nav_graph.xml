<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Back to the login screen from anywhere (session expired, logout). -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.testmarking.app.ui.splash.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/classesTeachingFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.testmarking.app.ui.login.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_verify"
            app:destination="@id/verifyEmailFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/classesTeachingFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.testmarking.app.ui.register.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_register_to_verify"
            app:destination="@id/verifyEmailFragment"
            app:popUpTo="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/verifyEmailFragment"
        android:name="com.testmarking.app.ui.verify.VerifyEmailFragment"
        android:label="Verify">
        <argument
            android:name="email"
            app:argType="string" />
        <argument
            android:name="autoResend"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_verify_to_home"
            app:destination="@id/classesTeachingFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/classesTeachingFragment"
        android:name="com.testmarking.app.ui.classes.ClassListFragment"
        android:label="Teaching">
        <argument
            android:name="scope"
            android:defaultValue="teacher"
            app:argType="string" />
        <action
            android:id="@+id/action_teaching_to_detail"
            app:destination="@id/classDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/classesLearningFragment"
        android:name="com.testmarking.app.ui.classes.ClassListFragment"
        android:label="Learning">
        <argument
            android:name="scope"
            android:defaultValue="student"
            app:argType="string" />
        <action
            android:id="@+id/action_learning_to_detail"
            app:destination="@id/classDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.testmarking.app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <fragment
        android:id="@+id/classDetailFragment"
        android:name="com.testmarking.app.ui.classes.ClassDetailFragment"
        android:label="Class detail">
        <argument
            android:name="classId"
            app:argType="string" />
        <action
            android:id="@+id/action_class_detail_to_take_exam"
            app:destination="@id/takeExamFragment" />
        <action
            android:id="@+id/action_class_detail_to_exam_manage"
            app:destination="@id/examManageFragment" />
    </fragment>

    <fragment
        android:id="@+id/takeExamFragment"
        android:name="com.testmarking.app.ui.exam.TakeExamFragment"
        android:label="Take exam">
        <argument
            android:name="examId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/examManageFragment"
        android:name="com.testmarking.app.ui.exam.ExamManageFragment"
        android:label="Exam detail">
        <argument
            android:name="examId"
            app:argType="string" />
        <argument
            android:name="examName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>
