    <string name="take_waiting_title">Đã lưu bài làm</string>
    <string name="take_waiting_body">Bài của bạn đã lưu trên máy và sẽ tự gửi lên hệ thống khi có mạng. Giữ ứng dụng trên máy, đừng gỡ cài đặt.</string>
    <string name="take_waiting_locked">Bài bị khóa do thoát màn hình làm bài. Giáo viên cần mở khóa trước khi bài được chấm.</string>
